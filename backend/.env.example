DATABASE_URL=postgresql://postgres:021415@localhost:5432/prashasak_ai_db
GEMINI_API_KEY=
SECRET_KEY=
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]
ENVIRONMENT=development

# RAG & Document Pipeline
MAX_PDF_SIZE_MB=25
STORAGE_DIR=storage/resources
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# Gemini Embeddings & Generation
GEMINI_EMBEDDING_MODEL=text-embedding-004
GEMINI_GENERATION_MODEL=gemini-3.8-flash
GEMINI_REQUEST_TIMEOUT=30.0
GEMINI_MAX_RETRIES=3
EMBEDDING_DIMENSION=768
EMBEDDING_BATCH_SIZE=16
RAG_TOP_K=5 
RAG_MIN_SIMILARITY=0.5

# Voice Engine Configuration
VOICE_STT_PROVIDER=fake
VOICE_TTS_PROVIDER=fake
VOICE_DEFAULT_LANGUAGE=en-IN
VOICE_DEFAULT_VOICE=default
VOICE_MAX_AUDIO_SIZE_MB=10
VOICE_MAX_DURATION_SECONDS=180
